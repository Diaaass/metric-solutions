GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Боевой базовый URL: canonical, hreflang, sitemap, OG. Локально — http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://metricsolutions.kz

# Котировки металлов (тикер над шапкой).
# Бесплатный ключ: https://metals.dev (100 запросов/мес). Без ключа полоса скрывается.
METALS_API_KEY=

# В dev тикер по умолчанию показывает фиксированные мок-цены, чтобы не жечь
# месячную квоту metals.dev. METALS_LIVE=1 включает живые данные локально.
# METALS_LIVE=1
